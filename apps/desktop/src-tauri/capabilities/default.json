{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults, fullscreen toggle (F11), open-folder/file dialog, opener (github.com links only), updater (inactive without a signing key).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        }
      ]
    },
    "updater:default"
  ]
}
